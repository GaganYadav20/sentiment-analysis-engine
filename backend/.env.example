# Sentiment Analysis Engine — Backend Environment Variables

# Application
APP_NAME=Sentiment Analysis Engine
APP_VERSION=1.0.0
DEBUG=false

# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./sentiment.db
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/sentiment

# JWT Authentication
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# ML Model
MODEL_NAME=nlptown/bert-base-multilingual-uncased-sentiment

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
